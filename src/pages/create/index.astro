// preview.astro) on the right.
import Base from '../../layouts/Base.astro';
import Creator from '../../components/Creator.svelte';
---
<Base title="create" description="Make a fluorokit theme: pick a base, accents, tiles and a font, see it live, get the code." hero={false} app>
  <Creator client:load />
</Base>
